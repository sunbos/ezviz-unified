  "state_policy": {
    "aliases": "六个菜单身份分别登记，只关闭导航来源；目标采用其独立来源的状态。",
    "37": "作为四端原生错误码资料完成整表结构和代表性释义核查；不转译为 Python 或服务端错误映射。",
    "4148": "Demo 表、字段、跨端与地区说明已核；精确安装包/版本、签名材料、原生 getDeviceList 的平台约定及其规范来源，另待完成。",
    "4146": "排错与受控反馈说明已核；原生预览验证、回放速率、以及 tkToken 的平台绑定/版本与进一步规范来源仍待完成。",
    "native_gate": "ACC-MEDIA-OFFICIAL-INTEGRATION-001 及 OTHER-COMPONENT-SCOPES 保持现状；本批不执行客户端、读取日志、调用设备或提交工单。"
  },
  "presentation": "README 指向中文指南；指南给出选择平台与官方 Demo、最低配置、两个错误码示例、隐私友好的问题反馈、未核范围及官方来源。只用公开、必要的字段名，不复制私有数据或整份错误码表。",
  "verification": {
    "entry": "docs/coordination/mobile-sdk-shared-references/verify.py",
    "normal_command": "python3 -O docs/coordination/mobile-sdk-shared-references/verify.py --repo . --snapshot-dir data/official-docs/2026-11-17-sdk-product-main",
    "negative_command": "python3 -O docs/coordination/mobile-sdk-shared-references/verify.py --repo . --snapshot-dir data/official-docs/2026-11-17-sdk-product-main --self-test",
    "invariants": [
      "逐页核对 catalog 原文件/正文 SHA、平台菜单、六条 E1 的原 HTML href/派生链接/独立 edges、三个目标实际元素及承载语义。",
      "不得用相同正文哈希合并不同入口或将目标误改为 iOS/Harmony 菜单。",
      "对账 scope-register 的九行及记录引用、能力/案例状态；真实运行标识必须为 false；归档缺失必须失败。",
      "对错配目标、互换同正文入口的平台、混淆 Demo 和 SDK 地区、把本地材料改成真机通过、把未决目标改为完成等真实改值做精确拒绝验证。"
    ]
