      },
      "assessment": "正文 E13/E17 指向应用模块 entry/libs/EZOpenSDK.har 本地依赖，E20 与 E23 分别设置 enableOverride 和 useNormalizedOHMUrl，但仅凭这些静态说明无法判断最终 HAP 实际选择了哪个同名 ELF。",
      "remaining": [
        "构建真实 HAP 后核对打包产中同名 ELF 的实际来源与版本。"
      ],
      "element_pointers": {
        "official_catalog_link": 3,
        "local_har_in_entry_libs": 13,
        "entry_local_dependency": 17,
        "native_library_filter": 20,
        "normalized_ohm_url": 23
      },
      "documented_local_dependency": {
        "name": "@ezviz/ezopensdk",
        "specifier": "file:./libs/EZOpenSDK.har"
      },
      "documented_build_options": {
        "nativeLib.filter.enableOverride": true,
        "strictMode.useNormalizedOHMUrl": true
      },
      "dependency_source": "本地 HAR 的相对 file 依赖，不以同名远程包替代。"
    },
